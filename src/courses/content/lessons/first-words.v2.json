      "responseMode": "choice",
      "prompt": "Choose the missing word.",
      "textBefore": "我",
      "textAfter": "安娜。",
      "translation": "My name is Anna.",
      "options": [
        { "id": "apply-jiao", "label": "叫", "supportingText": "jiào" },
        { "id": "apply-ye", "label": "也", "supportingText": "yě" },
        { "id": "apply-gaoxing", "label": "高兴", "supportingText": "gāoxìng" }
      ],
      "answer": "apply-jiao",
      "feedback": {
        "correct": "我叫安娜 keeps the same pattern while changing the name.",
        "retry": "The blank needs the action to be called between 我 and the name."
      }
    },
    {
      "id": "first-words-summary",
      "type": "content-explore/v1",
      "eyebrow": "Complete",
      "title": "Five words now form a usable path",
      "instruction": "Keep the words attached to their sounds and sentence jobs, not as an isolated list.",
