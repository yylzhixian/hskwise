        { "kind": "lexeme", "id": "lexeme.ye" }
      ],
      "takeaways": [
        "你好 opens the greeting.",
        "我 identifies the speaker.",
        "叫 connects 我 to a name.",
        "也 mirrors it with too.",
        "高兴 names the feeling."
      ]
