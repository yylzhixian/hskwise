    {
      "id": "first-words-meaning",
      "type": "single-choice/v1",
      "eyebrow": "Recognize",
      "title": "Match the word to its job",
      "instruction": "Choose the meaning that fits the introduction pattern.",
      "knowledgeIds": ["vocabulary.introduction-jiao"],
      "prompt": "What does 叫 do in 我叫林月?",
      "stimulus": { "kind": "lexeme", "ref": "lexeme.jiao" },
      "options": [
        { "id": "meaning-called", "label": "It means “to be called.”" },
        { "id": "meaning-greet", "label": "It means “to greet.”" },
        { "id": "meaning-happy", "label": "It means “to feel happy.”" }
      ],
      "answer": "meaning-called",
      "feedback": {
        "correct": "叫 links the speaker to a name: 我叫 + name.",
        "retry": "Keep 我 before the action and the name after it, then choose again."
      }
    },
    {
      "id": "first-words-listening",
      "type": "single-choice/v1",
      "eyebrow": "Hear",
      "title": "Recognize one word without its sentence",
      "instruction": "Listen first. The written choices unlock when the cue ends.",
      "knowledgeIds": ["vocabulary.adverb-ye"],
      "prompt": "Which word did you hear?",
      "stimulus": { "kind": "audio", "ref": "audio.first-word-ye" },
      "options": [
        { "id": "heard-wo", "label": "我", "supportingText": "wǒ" },
        { "id": "heard-ye", "label": "也", "supportingText": "yě" },
        { "id": "heard-jiao", "label": "叫", "supportingText": "jiào" },
        { "id": "heard-nihao", "label": "你好", "supportingText": "nǐ hǎo" }
      ],
      "answer": "heard-ye",
      "feedback": {
        "correct": "也 has a dipping third tone and adds also or too.",
        "retry": "Replay the short cue and listen for the third-tone dip in yě."
      }
    },
    {
      "id": "first-words-recall",
      "type": "active-recall/v1",
      "eyebrow": "Recall",
      "title": "Bring the word back before looking",
      "instruction": "Say the Mandarin word from memory. Reveal it only after you have made a real attempt.",
