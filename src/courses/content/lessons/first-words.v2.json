      "targetRef": { "kind": "lexeme", "id": "lexeme.gao-xing" },
      "cue": "How do you say happy or pleased in the greeting?",
      "revealLabel": "Reveal the word",
      "feedback": {
        "mastered": "You retrieved 高兴 before relying on the written form.",
        "review": "Keep 高兴 in review and compare gāo with xìng."
      }
    },
    {
      "id": "first-words-application",
      "type": "cloze/v1",
      "eyebrow": "Use",
      "title": "Put the word back into a new introduction",
      "instruction": "Complete the sentence with the word that connects 我 to a name.",
